# Application Configuration
APP_NAME="Apex Compliance Engine"
ENVIRONMENT="development"

# Database Configuration
# For local zero-setup dev: sqlite:///./compliance.db
# For PostgreSQL (e.g. Render/production): postgresql://user:password@localhost:5432/compliance_db
DATABASE_URL="sqlite:///./compliance.db"

# Security / JWT
SECRET_KEY="super-secret-compliance-ops-jwt-token-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
